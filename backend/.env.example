# LLM - provider agnostic, change without code
LLM_PROVIDER=mock
# options: openai, groq, gemini, anthropic, mock
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=
# Optional provider-specific overrides
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# RAG - optional, disabled by default (keyword retrieval, no vector DB)
RAG_ENABLED=false
RAG_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small

# Database - optional, disabled by default
SUPABASE_ENABLED=false
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
DATABASE_URL=postgresql://user:pass@localhost:5432/hackathon

# App
APP_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
API_TIMEOUT=30
# Optional fallback model retried ONCE on HTTP 429 only (per-model limits are
# separate on Groq, so e.g. openai/gpt-oss-120b may work when 20b is capped).
# Empty (default) disables the retry.
LLM_FALLBACK_MODEL=
# Rate limit per IP per minute on POST /api/solve, /api/solve/stream, /api/chat. 0 disables.
RATE_LIMIT_PER_MIN=600

# Feature flags (legacy aliases)
ENABLE_RAG=false
ENABLE_DB=false

# Auth - OFF by default; set JWT_SECRET to enable
AUTH_ENABLED=false
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
