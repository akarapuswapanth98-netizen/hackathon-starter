# LLM - provider agnostic, change without code
LLM_PROVIDER=mock
# options: openai, groq, gemini, anthropic, mock
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-your-key-here
# Optional provider-specific overrides
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# RAG - optional, disabled by default
RAG_ENABLED=false
# options: llama-index, mock
RAG_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small

# Database - optional, disabled by default
SUPABASE_ENABLED=false
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
DATABASE_URL=postgresql://user:pass@localhost:5432/hackathon

# App
APP_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
API_TIMEOUT=30

# Feature flags
ENABLE_RAG=false
ENABLE_DB=false
