# LLM - provider agnostic, change without code
LLM_PROVIDER=mock
# options: openai, groq, gemini, anthropic, mock
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=
# Optional provider-specific overrides
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# RAG - optional, disabled by default (keyword retrieval, no vector DB)
RAG_ENABLED=false
RAG_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small

# Database - optional, disabled by default
SUPABASE_ENABLED=false
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
DATABASE_URL=postgresql://user:pass@localhost:5432/hackathon

# App
APP_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
API_TIMEOUT=30
# Optional fallback model retried ONCE on HTTP 429 only (per-model limits are
# separate on Groq, so e.g. openai/gpt-oss-120b may work when 20b is capped).
# Empty (default) disables the retry.
LLM_FALLBACK_MODEL=
# Rate limit per IP per minute on POST /api/solve, /api/solve/stream, /api/chat. 0 disables.
RATE_LIMIT_PER_MIN=600

# Feature flags (legacy aliases)
ENABLE_RAG=false
ENABLE_DB=false

# Auth - OFF by default; set JWT_SECRET to enable
AUTH_ENABLED=false
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# ---------------------------------------------------------------------------
# FoodLink Predict (optional module). All values below are DEFAULTS, so deleting
# this block leaves the starter exactly as it is. Never put a secret here that
# the frontend needs - these are backend-only.
# ---------------------------------------------------------------------------
# Mount the module's /api/forecast, /api/risk, /api/recommend, /api/surplus,
# /api/impact, /api/ingest routes. false restores the starter's original surface.
FOODLINK_PREDICT_ENABLED=true
# Marks responses as demo mode (affects labelling only, not enforcement).
DEMO_MODE=true

# ML - requires the optional group: pip install -r requirements-foodlink-predict.txt
# Without scikit-learn every series falls back to cold-start and is labelled as such.
ML_PROVIDER=sklearn
# gradient_boosting (default, native quantile loss) | random_forest (tree-percentile quantiles)
FORECAST_MODEL=gradient_boosting
# FLP owns its own SQLite file by default, so DATABASE_URL is left untouched.
# Point this at Postgres only when you actually want FLP persistence elsewhere.
FOODLINK_PREDICT_DB_URL=
# Days of history before the model is trusted; below this -> cold-start fallback.
FORECAST_COLD_START_DAYS=14

# FoodLink adapter.
#   demo      (default) offline simulator. Every response is stamped demo=true.
#   http      real HTTP call - REFUSES to run until both URL and path are set,
#             because the real listing schema was never available to verify.
#   disabled  surplus endpoints return 503.
FOODLINK_ADAPTER_MODE=demo
FOODLINK_API_URL=
# Deliberately empty: this is the guessed-contract switch. Set it only once you
# have checked the mapping in app/projects/foodlink_predict/adapters/http.py
# against your actual FoodLink schema.
FOODLINK_LISTING_PATH=
# FOODLINK_API_KEY=

# Safety - these decide donate-by. Review them for your jurisdiction before live use.
# Defaults are conservative and NOT certified food-safety advice.
# JSON override, e.g. {"cooked":24,"chilled":48,"produce":72,"packaged":168}
SAFE_WINDOWS_JSON=
# Hours FoodLink needs to collect a confirmed listing.
PICKUP_LEAD_TIME_HOURS=6

# Impact factors. Indicative planning figures, surfaced in every /api/impact
# response so a UI can print them; they are not lifecycle assessments.
# kg CO2e avoided per kg of food diverted from landfill.
EMISSION_FACTOR_CO2E=2.5
# Grams of food per meal-equivalent.
KG_PER_MEAL=0.35
